# LLM fallback chain — tried in this order on every request:
#   1. Groq    (always tried first)
#   2. Gemini  (only if Groq is rate-limited or errors)
#   3. NVIDIA  (only if both Groq and Gemini fail)
# Any provider without a key is skipped.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional model overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite
# NVIDIA_MODEL=openai/gpt-oss-20b
